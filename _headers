  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Static art. Netlify's default for everything is max-age=0,must-revalidate,
# which meant all 153 backdrops (31MB) made a conditional round-trip on EVERY
# load including repeat visits — measured as ~12s of tail on a 10Mbit link.
# These files only ever change on a redeploy, so a long TTL is safe; if a
# backdrop is ever REPLACED under the same filename, either rename it or expect
# up to 30 days of staleness for returning visitors.
/assets/bg/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/cutouts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# The showcase renders and the GeoNames tables change only on a redeploy.
/assets/showcase/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/library-ads/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/geo/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Fontshare faces are versioned by name and genuinely never change.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The app itself must stay revalidating or a deploy would not reach anyone.
/app.js
  Cache-Control: public, max-age=0, must-revalidate

/offer-library.js
  Cache-Control: public, max-age=0, must-revalidate

/template-holds.js
  Cache-Control: public, max-age=0, must-revalidate

/offer-assets.js
  Cache-Control: public, max-age=0, must-revalidate

/photo-subjects.js
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/grounds.js
  Cache-Control: public, max-age=0, must-revalidate

/platform-mix.js
  Cache-Control: public, max-age=0, must-revalidate

/colour-builder.js
  Cache-Control: public, max-age=0, must-revalidate

# Owner tools that stay reachable by link but should never be in search:
# the good/bad picker, the asset library and the old single-file build.
# (The labs under /lab/ are 404'd by netlify.toml since 2026-10-06.)
# Mirrors netlify.toml.
/pick.html
  X-Robots-Tag: noindex, nofollow

/library.html
  X-Robots-Tag: noindex, nofollow

/phonegfx-studio.html
  X-Robots-Tag: noindex, nofollow

# TEMPORARY: the ad review admin (admin-ads/). Remove with the folder.
/admin-ads/*
  X-Robots-Tag: noindex, nofollow

# The video encoder is vendored under a versioned filename, so it can be cached
# for good; a new version gets a new name.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
