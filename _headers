  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Static art. Netlify's default for everything is max-age=0,must-revalidate,
# which meant all 153 backdrops (31MB) made a conditional round-trip on EVERY
# load including repeat visits — measured as ~12s of tail on a 10Mbit link.
# These files only ever change on a redeploy, so a long TTL is safe; if a
# backdrop is ever REPLACED under the same filename, either rename it or expect
# up to 30 days of staleness for returning visitors.
/assets/bg/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/cutouts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# The AI generator's picker thumbnails and model references (scripts/bggen_entities.py);
# the picker links them with ?v=ASSET_REV like every other asset.
/assets/bggen-thumbs/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/bggen-refs/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# The showcase renders and the GeoNames tables change only on a redeploy.
/assets/showcase/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/library-ads/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/geo/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Fontshare faces are versioned by name and genuinely never change.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The app itself must stay revalidating or a deploy would not reach anyone.
/app.js
  Cache-Control: public, max-age=0, must-revalidate

/offer-library.js
  Cache-Control: public, max-age=0, must-revalidate

/template-holds.js
  Cache-Control: public, max-age=0, must-revalidate

/template-retired.js
  Cache-Control: public, max-age=0, must-revalidate

/offer-assets.js
  Cache-Control: public, max-age=0, must-revalidate

/photo-subjects.js
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/grounds.js
  Cache-Control: public, max-age=0, must-revalidate

/platform-mix.js
  Cache-Control: public, max-age=0, must-revalidate

/colour-builder.js
  Cache-Control: public, max-age=0, must-revalidate

/device-walls.js
  Cache-Control: public, max-age=0, must-revalidate

/mac-wallpapers.js
  Cache-Control: public, max-age=0, must-revalidate

/full-ad-studio.js
  Cache-Control: public, max-age=0, must-revalidate

/full-ad-studio.css
  Cache-Control: public, max-age=0, must-revalidate

# The house look (DESIGN-LAW 145): its sheets and theme script carry no version in their names,
# so they revalidate like the app.
/house.css
  Cache-Control: public, max-age=0, must-revalidate

/pages.css
  Cache-Control: public, max-age=0, must-revalidate

/site-theme.js
  Cache-Control: public, max-age=0, must-revalidate

# Art that a redeploy may replace under the same name (2026-11-18): the real ads the pages and
# link previews show (scripts/build_og_cards.mjs), the brand files, the explainer videos and their
# posters, the photographs behind the ads and the video maker's phones and sounds. They revalidated
# on every visit; now a day, served stale for a week while a newer copy is fetched.
/assets/full-ads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/explainers/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/bg-web/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/bg-offer/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/motion/phones/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/motion/sounds/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/motion/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# For search engines and language models: plain text, an hour (scripts/build_seo_pages.mjs).
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# The video maker's two audit sheets and the master library are owner tools: never in search.
/motion/audit-sweep.html
  X-Robots-Tag: noindex, nofollow

/motion/views-sheet.html
  X-Robots-Tag: noindex, nofollow

/master-library.html
  X-Robots-Tag: noindex, nofollow

# Owner tools that stay reachable by link but should never be in search:
# the good/bad picker, the asset library and the old single-file build.
# Mirrors netlify.toml.
/pick.html
  X-Robots-Tag: noindex, nofollow

/approve.html
  X-Robots-Tag: noindex, nofollow

/library.html
  X-Robots-Tag: noindex, nofollow

/phonegfx-studio.html
  X-Robots-Tag: noindex, nofollow

# TEMPORARY: the ad review admin (admin-ads/). Remove with the folder.
/admin-ads/*
  X-Robots-Tag: noindex, nofollow

/social/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, max-age=0, must-revalidate

# The video encoder is vendored under a versioned filename, so it can be cached
# for good; a new version gets a new name.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
