# Local development secrets for `netlify dev` (production values live in the
# Netlify site env, run `netlify env:list --plain` after `netlify link` and
# copy them here). Never commit the real .env.
JWT_SECRET=copy-from-netlify-env
GEMINI_KEY=copy-from-netlify-env
# fal.ai: the AI background generator's first provider (Seedream; with products
# picked, Seedream edit with the shop's photographs as references), and
# scripts/fal_assets.mjs. Each image is charged to the fal balance. Claude cloud
# sessions read it from the environment's settings, not from this file.
FAL_KEY=
ADMIN_EMAILS=myleskcb@gmail.com,myleskcb2@gmail.com
# Optional:
# GOOGLE_CLIENT_ID=            enables the Google sign-in button
# RL_USER_DAILY=10             free-plan AI backgrounds per day
# RL_PRO_DAILY=40              pro-plan AI backgrounds per day
# RL_GLOBAL_DAILY=400          site-wide AI backgrounds per day
# AI_CREDIT_UNIT=credits       or tokens: what the generator calls its unit
# AI_CREDITS_FREE=10           a month, Free plan
# AI_CREDITS_PRO=150           a month, Pro plan
# AI_CREDIT_COST=1             an image, scene only
# AI_CREDIT_COST_REF=2         an image with products from the catalogue
# AI_MAX_PER_RUN=4             images one Generate can ask for
# AI_USD_PER_IMAGE=0.03        provider price, shown to operators only
# AI_USD_PER_IMAGE_REF=0.03
# PGFX_BG_PROVIDER=            fal (default when FAL_KEY is set) or gemini
# PGFX_FAL_TEXT_MODEL=         default fal-ai/bytedance/seedream/v4/text-to-image
# PGFX_FAL_EDIT_MODEL=         default fal-ai/bytedance/seedream/v4/edit
# PGFX_HOUSE_FRAME=            master prompt template ({lead} {subject} {anchor} {look} {palette} {composition} {quality}); the AI Studio's recipe editor is easier
# PGFX_CATEGORY_ANCHORS=       JSON merged over per-category anchors, e.g. {"gold":"warm brass tones"}
